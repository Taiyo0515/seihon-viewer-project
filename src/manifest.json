{
  "manifest_version": 3,
  "name": "製本ビューア",
  "short_name": "製本ビューア",
  "version": "0.16.0",
  "description": "PDFを見開きで読み、必要なページを収集・編集して保存するビューア。電子書籍や原稿のプレビュー、印刷・製本にも対応します。",
  "minimum_chrome_version": "128",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "製本ビューアで開く",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess",
    "webNavigation",
    "webRequest",
    "scripting",
    "contextMenus",
    "downloads",
    "clipboardWrite",
    "unlimitedStorage",
    "offscreen"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*", "https://*/*", "file:///*"
  ],
  "options_page": "options/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "viewer/viewer.html"
      ],
      "matches": [
        "http://*/*", "https://*/*", "file:///*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "sandbox": {"pages": ["reader/markup-engine.html"]},
  "incognito": "split"
}
