{
  "manifest_version": 3,
  "name": "製本ビューア",
  "short_name": "製本ビューア",
  "version": "0.4.1",
  "description": "製本表示(表紙単独+見開き)に対応したPDFビューア。電子書籍(EPUB・MOBI・AZW3)とコミック(CBZ・CBR)も表示できます。",
  "minimum_chrome_version": "128",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "製本ビューアで開く",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess",
    "webNavigation",
    "webRequest",
    "scripting",
    "contextMenus",
    "downloads",
    "downloads.ui",
    "clipboardWrite",
    "unlimitedStorage",
    "offscreen"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_page": "options/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "viewer/viewer.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "incognito": "split"
}
